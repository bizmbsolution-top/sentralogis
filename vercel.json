{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/health",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/trucking-check",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/wms-check",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/forwarding-check",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/sla-snapshot",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/jo-autostart",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/jo-autocomplete",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/easygo/sync-gps",
      "schedule": "*/5 * * * *"
    }
  ]
}
